---
import Layout from '../layouts/base.astro'
import { getAllPosts, getAllChannels, getChannelData, getDigestTitle } from '../lib/data'

const digestTitle = getDigestTitle()
const allPosts = getAllPosts()
const channels = getAllChannels()

const channel = getChannelData()
channel.title = `${digestTitle} — Stats`
channel.description = 'Digest statistics'
channel.descriptionHTML = null
channel.avatar = undefined
channel.seo = { title: 'Stats' }

const SITE_URL = import.meta.env.BASE_URL ?? '/'

// Posts per channel
const maxChannelPosts = Math.max(...channels.map((c) => c.postCount), 1)

// Sum reactions helper
function sumReactions(post: (typeof allPosts)[0]): number {
  if (!post.reactions || post.reactions.length === 0) return 0
  return post.reactions.reduce((sum, r) => sum + (Number.parseInt(String(r.count), 10) || 0), 0)
}

// Top 10 by reactions
const topByReactions = [...allPosts].sort((a, b) => sumReactions(b) - sumReactions(a)).slice(0, 10)
const maxReactions = Math.max(...topByReactions.map((p) => sumReactions(p)), 1)

// Posts per day for last 7 days
const now = new Date()
const days: { label: string; count: number }[] = []
for (let i = 6; i >= 0; i--) {
  const d = new Date(now)
  d.setDate(d.getDate() - i)
  const dateStr = d.toISOString().slice(0, 10)
  const label = `${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`
  const count = allPosts.filter((p) => p.datetime.startsWith(dateStr)).length
  days.push({ label, count })
}
const maxDayCount = Math.max(...days.map((d) => d.count), 1)
---

<Layout channel={channel}>
  <div style="margin-bottom:16px;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
      <h1 style="font-size:20px;font-weight:600;margin:0;">Stats</h1>
      <div style="display:flex;gap:4px;margin-left:auto;">
        <a href={SITE_URL} class="nav-pill">Home</a>
        <a href={`${SITE_URL}hot/`} class="nav-pill">Hot</a>
        <a href={`${SITE_URL}lite/`} class="nav-pill">Lite</a>
        <button onclick="toggleTheme()" class="nav-pill" aria-label="Toggle theme" id="theme-btn"></button>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:20px;margin-bottom:24px;flex-wrap:wrap;">
    <div
      style="background:var(--color-code);border:1px solid var(--color-line);border-radius:8px;padding:16px 24px;text-align:center;"
    >
      <div style="font-size:28px;font-weight:700;color:var(--color-heading);">{allPosts.length}</div>
      <div style="font-size:13px;color:var(--color-muted);">Total posts</div>
    </div>
    <div
      style="background:var(--color-code);border:1px solid var(--color-line);border-radius:8px;padding:16px 24px;text-align:center;"
    >
      <div style="font-size:28px;font-weight:700;color:var(--color-heading);">{channels.length}</div>
      <div style="font-size:13px;color:var(--color-muted);">Channels</div>
    </div>
  </div>

  <h2 style="font-size:16px;font-weight:600;margin:0 0 12px;">Posts per channel</h2>
  <div style="margin-bottom:24px;">
    {
      channels.map((ch) => (
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;font-size:13px;">
          <span style="min-width:100px;text-align:right;color:var(--color-muted);">@{ch.name}</span>
          <div style="flex:1;background:var(--color-line);border-radius:4px;height:20px;overflow:hidden;">
            <div
              style={`width:${Math.round((ch.postCount / maxChannelPosts) * 100)}%;background:var(--color-accent);height:100%;border-radius:4px;min-width:2px;`}
            />
          </div>
          <span style="min-width:30px;font-size:12px;color:var(--color-muted);">{ch.postCount}</span>
        </div>
      ))
    }
  </div>

  <h2 style="font-size:16px;font-weight:600;margin:0 0 12px;">Top 10 posts by reactions</h2>
  <div style="margin-bottom:24px;">
    {
      topByReactions.map((post) => {
        const total = sumReactions(post)
        const preview = post.text?.slice(0, 80) || '(no text)'
        return (
          <div style="margin-bottom:8px;">
            <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
              <a
                href={`${SITE_URL}posts/${post.id}`}
                style="min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--color-link);"
                title={preview}
              >
                @{post.channel}: {preview}
              </a>
              <span style="min-width:40px;text-align:right;font-size:12px;color:var(--color-muted);white-space:nowrap;">
                {total}
              </span>
            </div>
            <div style="background:var(--color-line);border-radius:4px;height:8px;overflow:hidden;margin-top:2px;">
              <div
                style={`width:${Math.round((total / maxReactions) * 100)}%;background:var(--color-accent);height:100%;border-radius:4px;min-width:2px;`}
              />
            </div>
          </div>
        )
      })
    }
  </div>

  <h2 style="font-size:16px;font-weight:600;margin:0 0 12px;">Activity (last 7 days)</h2>
  <div style="display:flex;align-items:flex-end;gap:6px;height:120px;margin-bottom:24px;">
    {
      days.map((day) => (
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;">
          <span style="font-size:11px;color:var(--color-muted);margin-bottom:4px;">{day.count}</span>
          <div
            style={`width:100%;background:var(--color-accent);border-radius:4px 4px 0 0;height:${Math.max(Math.round((day.count / maxDayCount) * 100), day.count > 0 ? 4 : 0)}%;min-height:${day.count > 0 ? '4px' : '0'};`}
          />
          <span style="font-size:10px;color:var(--color-muted);margin-top:4px;">{day.label}</span>
        </div>
      ))
    }
  </div>
</Layout>
