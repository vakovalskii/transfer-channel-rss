---
import Layout from '../layouts/base.astro'
import Item from '../components/item.astro'
import { getAllPosts, getChannelData, getDigestTitle } from '../lib/data'

const digestTitle = getDigestTitle()
const allPosts = getAllPosts()

function sumReactions(post: (typeof allPosts)[0]): number {
  if (!post.reactions || post.reactions.length === 0) return 0
  return post.reactions.reduce((sum, r) => sum + (Number.parseInt(String(r.count), 10) || 0), 0)
}

const hotPosts = [...allPosts].sort((a, b) => sumReactions(b) - sumReactions(a)).slice(0, 50)

const channel = getChannelData()
channel.title = `${digestTitle} — Hot`
channel.description = 'Top 50 posts by reactions'
channel.descriptionHTML = null
channel.avatar = undefined
channel.seo = { title: 'Hot' }

const SITE_URL = import.meta.env.BASE_URL ?? '/'
---

<Layout channel={channel}>
  <div style="margin-bottom:16px;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
      <h1 style="font-size:20px;font-weight:600;margin:0;">Hot posts</h1>
      <div style="display:flex;gap:4px;margin-left:auto;">
        <a href={SITE_URL} class="nav-pill">Home</a>
        <a href={`${SITE_URL}stats/`} class="nav-pill">Stats</a>
        <a href={`${SITE_URL}lite/`} class="nav-pill">Lite</a>
        <button onclick="toggleTheme()" class="nav-pill" aria-label="Toggle theme" id="theme-btn"></button>
      </div>
    </div>
    <p style="font-size:14px;color:#888;margin:0 0 12px;">Top 50 posts by total reactions</p>
  </div>

  <ol class="mt-5 mb-0 ml-7 list-none pl-0 max-sm:ml-0" aria-label="Hot posts">
    {
      hotPosts.map((post) => (
        <li>
          <Item post={post} isItem={false} />
        </li>
      ))
    }
  </ol>
</Layout>
