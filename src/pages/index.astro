---
import Layout from '../layouts/base.astro'
import Item from '../components/item.astro'
import { getChannelData, getAllChannels, getAllPosts, getDigestTitle } from '../lib/data'

const channels = getAllChannels()
const totalPosts = channels.reduce((sum, ch) => sum + ch.postCount, 0)
const digestTitle = getDigestTitle()

const channel = getChannelData()
channel.title = digestTitle
channel.description = `${totalPosts} posts from ${channels.length} channels`
channel.descriptionHTML = null
channel.avatar = undefined

const SITE_URL = import.meta.env.BASE_URL ?? '/'
const posts = channel.posts ?? []
const beforeCursor = posts[posts.length - 1]?.id

// Hot posts (top 5 by reactions)
const allPosts = getAllPosts()
function sumReactions(p: typeof allPosts[0]): number {
  if (!p.reactions?.length) return 0
  return p.reactions.reduce((s, r) => s + (parseInt(String(r.count), 10) || 0), 0)
}
const hotPosts = [...allPosts].sort((a, b) => sumReactions(b) - sumReactions(a)).slice(0, 5)
---

<Layout channel={channel}>
  <div style="margin-bottom:16px;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
      <h1 style="font-size:20px;font-weight:600;margin:0;">{digestTitle}</h1>
      <div style="display:flex;gap:4px;margin-left:auto;">
        <a href={`${SITE_URL}hot/`} class="nav-pill">Hot</a>
        <a href={`${SITE_URL}stats/`} class="nav-pill">Stats</a>
        <a href={`${SITE_URL}lite/`} class="nav-pill">Lite</a>
        <button onclick="toggleTheme()" class="nav-pill" id="theme-btn" aria-label="Toggle theme"></button>
      </div>
    </div>
    <p style="font-size:14px;color:#888;margin:0 0 12px;">{totalPosts} posts from {channels.length} channels</p>

    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;">
      <button class="filter-btn active" data-period="all" onclick="filterPeriod('all')">All</button>
      <button class="filter-btn" data-period="24h" onclick="filterPeriod('24h')">24h</button>
      <button class="filter-btn" data-period="3d" onclick="filterPeriod('3d')">3 days</button>
      <button class="filter-btn" data-period="7d" onclick="filterPeriod('7d')">Week</button>
    </div>

    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;">
      <button class="channel-btn active" data-channel="all" onclick="filterChannel('all')">All</button>
      {
        channels.map((ch) => (
          <button class="channel-btn" data-channel={ch.name} onclick={`filterChannel('${ch.name}')`}>
            @{ch.name} <span style="opacity:0.6;">({ch.postCount})</span>
          </button>
        ))
      }
    </div>

    <input
      id="digest-search"
      type="search"
      placeholder="Search posts..."
      oninput="filterSearch(this.value)"
      style="width:100%;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px;box-sizing:border-box;"
    />
  </div>

  <!-- Hot & Stats compact -->
  <div style="display:flex;gap:16px;margin-bottom:20px;flex-wrap:wrap;">
    <div style="flex:1;min-width:250px;border:1px solid #eee;border-radius:10px;padding:12px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
        <strong style="font-size:14px;">Hot</strong>
        <a href={`${SITE_URL}hot/`} style="font-size:11px;color:#999;text-decoration:none;">see all</a>
      </div>
      {hotPosts.map((p, i) => (
        <a href={`${SITE_URL}posts/${p.id}`} style="display:block;padding:4px 0;border-bottom:1px solid #f5f5f5;text-decoration:none;color:inherit;font-size:13px;">
          <span style="color:#999;margin-right:4px;">{i + 1}.</span>
          <span style="background:#eee;border-radius:3px;padding:0 4px;font-size:11px;color:#666;margin-right:4px;">@{p.channel}</span>
          <span style="color:#333;">{p.text?.slice(0, 60)}{(p.text?.length || 0) > 60 ? '...' : ''}</span>
          <span style="float:right;font-size:11px;color:#999;">{sumReactions(p)}</span>
        </a>
      ))}
    </div>
    <div style="flex:1;min-width:250px;border:1px solid #eee;border-radius:10px;padding:12px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
        <strong style="font-size:14px;">Channels</strong>
        <a href={`${SITE_URL}stats/`} style="font-size:11px;color:#999;text-decoration:none;">stats</a>
      </div>
      {channels.slice(0, 7).map(ch => (
        <div style="display:flex;align-items:center;gap:6px;padding:3px 0;font-size:13px;">
          <span style="color:#333;flex:1;">@{ch.name}</span>
          <div style="flex:2;height:8px;background:#f0f0f0;border-radius:4px;overflow:hidden;">
            <div style={`width:${(ch.postCount / channels[0].postCount * 100)}%;height:100%;background:#6c63ff;border-radius:4px;`}></div>
          </div>
          <span style="font-size:11px;color:#999;min-width:24px;text-align:right;">{ch.postCount}</span>
        </div>
      ))}
    </div>
  </div>

  <h2 style="font-size:16px;font-weight:600;margin:0 0 8px;">Latest</h2>
  <ol id="posts-list" class="mt-5 mb-0 ml-7 list-none pl-0 max-sm:ml-0" aria-label="Posts">
    {
      posts.map((post) => (
        <li
          class="digest-post"
          data-channel={post.channel || ''}
          data-datetime={post.datetime}
          data-text={post.text?.toLowerCase().slice(0, 500) || ''}
        >
          <Item post={post} isItem={false} />
        </li>
      ))
    }
  </ol>

  <nav style="margin:20px 0;display:flex;justify-content:center;">
    {
      beforeCursor && (
        <a
          href={`${SITE_URL}before/${beforeCursor}`}
          style="display:inline-flex;min-height:36px;align-items:center;justify-content:center;border-radius:30px;border:1px solid #ccc;padding:5px 15px;font-size:14px;color:#666;text-decoration:none;"
        >
          Load more
        </a>
      )
    }
  </nav>

  <p id="no-results" style="display:none;text-align:center;color:#999;padding:40px 0;">
    No posts on this page match filters.<br />
    <a href={`${SITE_URL}lite/`} style="color:#666;">Try lite mode with more posts</a>
  </p>
</Layout>

<style is:global>
  .filter-btn,
  .channel-btn {
    padding: 4px 12px;
    border: 1px solid #ddd;
    border-radius: 16px;
    background: #f8f8f8;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-btn:hover,
  .channel-btn:hover {
    border-color: #999;
  }
  .filter-btn.active,
  .channel-btn.active {
    background: #1a1a2e;
    color: #fff;
    border-color: #1a1a2e;
  }
  .nav-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border: 1px solid #ddd;
    border-radius: 16px;
    background: #f8f8f8;
    font-size: 12px;
    color: #555;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s;
  }
  .nav-pill:hover {
    background: #1a1a2e;
    color: #fff;
    border-color: #1a1a2e;
  }
  html[data-theme='dark'] .nav-pill {
    background: #333;
    border-color: #555;
    color: #ccc;
  }
  html[data-theme='dark'] .nav-pill:hover {
    background: #6c63ff;
    border-color: #6c63ff;
    color: #fff;
  }
</style>

<script is:inline src={`${import.meta.env.BASE_URL}digest.js`}></script>
